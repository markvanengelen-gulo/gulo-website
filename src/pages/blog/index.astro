const getIcon = (slug: string) => icons[slug] ?? fallbackIcon;
---

<BaseLayout 
  title="Blog - Gulo AI Insights"
  description="Stay updated with the latest trends, insights, and best practices in artificial intelligence and machine learning."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <img src={iconSrc.src} alt="Gulo AI icon" class="hero-brand-icon" width="80" height="80" />
      <h1>Gulo AI Blog</h1>
      <p>Insights, trends, and best practices in artificial intelligence</p>
    </div>
  </section>

  <!-- Blog Posts -->
  <section>
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => {
          const icon = getIcon(post.slug);

          return (
            <a href={`${base}blog/${post.slug}`} class="blog-card">
              <div class="blog-card-image" style={`background: ${post.image};`}></div>
              <div class="blog-card-content">
                <div
                  style={`width:64px; height:64px; border-radius:14px; background:${icon.bg}; color:${icon.color}; display:flex; align-items:center; justify-content:center; margin-bottom:12px; flex-shrink:0;`}
                >
                  <Fragment set:html={icon.svg} />
                </div>
                <h3 class="blog-card-title">{post.title}</h3>
                <p class="blog-card-excerpt">{post.excerpt}</p>
                <div class="blog-card-meta">{post.meta}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
