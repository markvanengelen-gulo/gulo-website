---
import BaseLayout from '../../layouts/BaseLayout.astro';
import iconSrc from '../../gulo_icon_white_transparent.png';
const base = import.meta.env.BASE_URL;

// Dynamically load all .md blog posts
const allPosts = await Astro.glob('./*.md');

// Filter to published posts only, sort newest first
const posts = allPosts
  .filter(p => p.frontmatter.published !== false)
  .sort((a, b) => {
    const dateA = new Date(a.frontmatter.publishDate || a.frontmatter.date || 0);
    const dateB = new Date(b.frontmatter.publishDate || b.frontmatter.date || 0);
    return dateB.getTime() - dateA.getTime();
  });

// Format date for display
function formatDate(dateStr: string): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Fallback icon for all posts
const fallbackIcon = {
  bg: "#e0e7ff",
  color: "#4338ca",
  svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>`
};

// Tag-based icon colours for variety
const tagColours: Record<string, { bg: string; color: string }> = {
  cybersecurity:  { bg: "#fee2e2", color: "#b91c1c" },
  security:       { bg: "#fee2e2", color: "#b91c1c" },
  ai:             { bg: "#e0e7ff", color: "#4338ca" },
  "data sovereignty": { bg: "#dbeafe", color: "#1d4ed8" },
  "managed it":   { bg: "#dcfce7", color: "#15803d" },
  architecture:   { bg: "#ede9fe", color: "#7c3aed" },
  cloud:          { bg: "#cffafe", color: "#0e7490" },
  pipeda:         { bg: "#fef3c7", color: "#b45309" },
  compliance:     { bg: "#fef3c7", color: "#b45309" },
};

function getIconStyle(tags: string[] = []) {
  for (const tag of tags) {
    const style = tagColours[tag.toLowerCase()];
    if (style) return { ...style, svg: fallbackIcon.svg };
  }
  return fallbackIcon;
}
---

<BaseLayout
  title="Blog - Gulo AI Insights"
  description="Stay updated with the latest trends, insights, and best practices in artificial intelligence, cybersecurity, and managed IT for Canadian organizations."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <img src={iconSrc.src} alt="Gulo AI icon" class="hero-brand-icon" width="80" height="80" />
      <h1>Gulo AI Blog</h1>
      <p>Insights, trends, and best practices for Canadian IT and business leaders</p>
    </div>
  </section>

  <!-- Blog Posts -->
  <section>
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => {
          const fm = post.frontmatter;
          const slug = post.file.split('/').pop()?.replace('.md', '');
          const icon = getIconStyle(fm.tags);
          const dateStr = formatDate(fm.publishDate || fm.date);

          return (
            <a href={`${base}blog/${slug}`} class="blog-card">
              <div class="blog-card-image" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);"></div>
              <div class="blog-card-content">
                <div
                  style={`width:64px; height:64px; border-radius:14px; background:${icon.bg}; color:${icon.color}; display:flex; align-items:center; justify-content:center; margin-bottom:12px; flex-shrink:0;`}
                >
                  <Fragment set:html={icon.svg} />
                </div>
                <h3 class="blog-card-title">{fm.title?.replace(' - Gulo AI Blog', '')}</h3>
                <p class="blog-card-excerpt">{fm.description}</p>
                <div class="blog-card-meta">{dateStr} · 7 min read</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
