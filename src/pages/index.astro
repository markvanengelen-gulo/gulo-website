---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

type IconDefinition = {
  bg: string;
  color: string;
  svg: string;
};

const latestInsightIcons: Record<string, IconDefinition> = {
  "blog-03-privilege-escalation": {
    bg: "#ede9fe", color: "#7c3aed",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 11 12 6 7 11"/><polyline points="17 18 12 13 7 18"/></svg>`
  },
  "blog-02-dangerous-misconfigurations": {
    bg: "#fef3c7", color: "#b45309",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="12" r="1"/><circle cx="15" cy="12" r="1"/><path d="M8 20l1-6-5-2 9-9 1 6 5 2-9 9z"/></svg>`
  },
  "blog-01-iam-silent-threat": {
    bg: "#fee2e2", color: "#b91c1c",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 5-4 8-8 9-4-1-8-4-8-9V7l8-4z"/><line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/></svg>`
  }
};

const latestInsightFallbackIcon: IconDefinition = {
  bg: "#f1f5f9",
  color: "#475569",
  svg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>`
};

const latestInsightImage = "linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)";
const blogModules = await Astro.glob('./blog/*.{md,astro}');
const latestInsights = blogModules
  .map((module) => {
    const frontmatter = (module.frontmatter ?? {}) as Record<string, string | undefined>;
    const slug = frontmatter.slug;
    const title = frontmatter.title;
    const excerpt = frontmatter.description;
    const publishDate = frontmatter.publishDate;
    const published = frontmatter.published;

    if (!slug || !title || !excerpt || !publishDate || published === 'false') {
      return null;
    }

    return {
      slug,
      title,
      excerpt,
      publishDate
    };
  })
  .filter((post): post is { slug: string; title: string; excerpt: string; publishDate: string } => post !== null)
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .slice(0, 2);
---

<BaseLayout 
  title="Gulo AI — AI Services, Cloud Advisory &amp; AWS Security"
  description="AI services, cloud advisory, and AWS security from a Canadian-based team. Horizon IAM Risk Analyzer detects IAM misconfigurations automatically — available globally on AWS Marketplace."
  ogTitle="Gulo AI — AI Services, Cloud Advisory &amp; AWS Security"
  ogDescription="AI services, cloud advisory, and AWS security from a Canadian-based team. Horizon IAM Risk Analyzer is available globally on AWS Marketplace."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1>AI Services, Cloud Advisory &amp; AWS Security — Canadian-Based, Globally Delivered</h1>
      <p>Practical AI and cloud services from a Canadian-based team, with Horizon IAM Risk Analyzer available globally on AWS Marketplace. Canadian data sovereignty options available.</p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href={`${base}services`} class="btn btn-primary btn-large">Explore Our Services</a>
      </div>
    </div>
  </section>

  <!-- How We Work Section -->
  <section>
    <div class="container">
      <h2 class="section-title">How We Work</h2>
      <p class="section-subtitle">Our approach combines Canadian insight with practical execution</p>
      
      <div class="grid grid-3">
        <div class="card">
          <h3>AI &amp; Cloud Expertise</h3>
          <p>Deep capability across AI, data, and cloud — delivering practical, production-ready solutions that integrate into your existing environment.</p>
        </div>
        
        <div class="card">
          <h3>Outcome-Focused</h3>
          <p>We prioritize results over hype — solving real problems with fit-for-purpose technology.</p>
        </div>
        
        <div class="card">
          <h3>Globally Capable, Canadian-Based</h3>
          <p>A Canadian-based team delivering AI and cloud security services worldwide, with Canadian data sovereignty options for regulated industries — PIPEDA, PIPA, and Bill C-26 compliant.</p>
        </div>
      </div>
      
      <div style="text-align: center; margin-top: 2rem;">
        <a href={`${base}about`} class="btn btn-primary">Learn more about us →</a>
      </div>
    </div>
  </section>

  <!-- What We Do - Services Preview -->
  <section class="bg-light">
    <div class="container">
      <h2 class="section-title">What We Do</h2>
      <p class="section-subtitle">Practical technology, data, AI, and cybersecurity services that deliver measurable outcomes</p>
      
      <div class="grid grid-2">
        <div class="card featured-product" style="grid-column: 1 / -1; border: 2px solid var(--primary-color, #1e40af); background: #f0f4ff;">
          <h3>Horizon IAM Risk Analyzer</h3>
          <p>Our AI-powered AWS security tool detects IAM misconfigurations, maps privilege escalation paths, and delivers plain-language remediation guidance. Available globally on AWS Marketplace — free 14-day trial included.</p>
          <a href="https://aws.amazon.com/marketplace" class="btn btn-primary">View on AWS Marketplace →</a>
        </div>

        <div class="card">
          <h3>Data &amp; AI Project Services</h3>
          <p>From strategy to production — AI that actually delivers results. We help bridge the gap by designing, building, and operationalizing data and AI solutions that are secure, scalable, and aligned to real business needs.</p>
          <a href={`${base}services#data-ai`} class="btn btn-primary">Learn more →</a>
        </div>
        
        <div class="card">
          <h3>Architecture Services</h3>
          <p>Clear direction. Practical roadmaps. Architecture that actually gets built. We help translate business goals into actionable technology roadmaps, grounded in current-state realities and future-state ambition.</p>
          <a href={`${base}services#architecture`} class="btn btn-primary">Learn more →</a>
        </div>

        <div class="card">
          <h3>Cybersecurity Services</h3>
          <p>Security that enables progress — not just compliance. We help organizations build secure, resilient environments that support their strategic objectives with a risk-based, outcome-focused approach.</p>
          <a href={`${base}services#cybersecurity`} class="btn btn-primary">Learn more →</a>
        </div>
        
        <div class="card">
          <h3>Managed IT Services</h3>
          <p>Reliable, proactive IT management — so you can focus on what matters. We provide secure, proactive support for your infrastructure, applications, and operations, handling the complexity so your team can focus on delivering value.</p>
          <a href={`${base}services#managed-it`} class="btn btn-primary">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Preview Section -->
  <section>
    <div class="container">
      <h2 class="section-title">Latest Insights</h2>
      <p class="section-subtitle">Stay updated with trends, best practices, and AI insights</p>
      
      <div class="grid grid-2">
        {latestInsights.map((post) => {
          const icon = latestInsightIcons[post.slug] ?? latestInsightFallbackIcon;

          return (
            <a href={`${base}blog/${post.slug}`} class="blog-card">
              <div class="blog-card-image" style={`background: ${latestInsightImage};`}></div>
              <div class="blog-card-content">
                <div
                  style={`width:64px; height:64px; border-radius:14px; background:${icon.bg}; color:${icon.color}; display:flex; align-items:center; justify-content:center; margin-bottom:12px; flex-shrink:0;`}
                >
                  <Fragment set:html={icon.svg} />
                </div>
                <h3 class="blog-card-title">{post.title}</h3>
                <p class="blog-card-excerpt">{post.excerpt}</p>
                <div class="blog-card-meta">{new Date(post.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
              </div>
            </a>
          );
        })}
      </div>
      
      <div style="text-align: center; margin-top: 2rem;">
        <a href={`${base}blog`} class="btn btn-primary">View All Articles →</a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="bg-light">
    <div class="container">
      <h2 class="section-title">Proven Track Record</h2>
      <div class="grid grid-3">
        <div class="text-center">
          <h2 class="text-primary">100+</h2>
          <p>Projects Completed</p>
        </div>
        <div class="text-center">
          <h2 class="text-primary">98%</h2>
          <p>Client Satisfaction</p>
        </div>
        <div class="text-center">
          <h2 class="text-primary">10+</h2>
          <p>Enterprise Clients</p>
        </div>
        <div class="text-center">
          <h2 class="text-primary">Global</h2>
          <p>AWS Marketplace Distribution</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section style="background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%); color: white;">
    <div class="container text-center">
      <h2 style="color: white;">Ready to Move Forward?</h2>
      <p style="color: rgba(255, 255, 255, 0.9); font-size: 1.125rem; margin-bottom: 2rem;">
        Whether you're building AI solutions, modernizing cloud architecture, or strengthening AWS security — Gulo AI brings global capability with Canadian accountability.
      </p>
      <a href={`${base}contact`} class="btn btn-primary btn-large btn-white" style="color: white;">
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
